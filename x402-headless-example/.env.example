# 0x indicative price: sell 1 USDC for WETH on Base, paying with TEST USDC.
# Payment chain (CHAIN_ID below) and swap chain (query chainId) are independent.
AGENTPAY_URL=https://agent.api.0x.org/v1/x402-testnet/swap-allowance-holder-price?chainId=8453&sellToken=0x833589fcd6edb6e08f4c7c32d4f71b54bda02913&buyToken=0x4200000000000000000000000000000000000006&sellAmount=1000000
# Commands select price or quote automatically; keep the swap query above.
# Optional quote taker: overrides URL taker, otherwise defaults to the payer.
TAKER=
# Dedicated test wallet, funded with Base Sepolia USDC. Never commit its key.
PRIVATE_KEY=
# 0x recipient observed in the endpoint's 402 challenge; verify before use.
PAY_TO=0xb15a55e85FdF5edc41B6c1eaf7813e2c6e6def59
# Supported here: 84532 (Base Sepolia) or 8453 (Base).
CHAIN_ID=84532
# Optional; defaults to the selected chain's public RPC.
RPC_URL=
# Integer USDC base units (6 decimals): 10000 = $0.01.
MAX_PAYMENT_AMOUNT=10000
# Batch: at most $2 per deposit, including automatic top-ups.
MAX_DEPOSIT_AMOUNT=2000000
# Batch: number of sequential paid GET requests in one run.
REQUEST_COUNT=3

# Cross-chain API access only: these commands print quotes/status/sources/SSE.
# Keep AGENTPAY_URL above; the command selects the route and payment channel.
# Query parameter values must be JSON strings, including amounts and chain IDs.
# Example route: Base USDC -> Arbitrum USDC. Replace originAddress with your wallet.
CROSS_CHAIN_PARAMS='{"originChain":"8453","destinationChain":"42161","sellToken":"0x833589fcd6edb6e08f4c7c32d4f71b54bda02913","buyToken":"0xaf88d065e77c8cc2239327c5edb3a432268e5831","sellAmount":"1000000","originAddress":"","sortQuotesBy":"price"}'
# For status only: fill in an actual transaction's originChain/originTxHash.
# Include its quoteId when available, especially for bundled transactions.
CROSS_CHAIN_STATUS_PARAMS='{"originChain":"8453","originTxHash":""}'

# Full swap command only: executes one real USDC -> WETH swap on Base mainnet.
# Swap chain is query chainId=8453; payment CHAIN_ID can still be 84532 or 8453.
# Optional Base MAINNET RPC, separate from the payment RPC_URL above.
SWAP_RPC_URL=
# USDC base units: sellAmount must be <= this limit (1000000 = 1 USDC).
MAX_SELL_AMOUNT=1000000
# Quote slippage in basis points (100 = 1%; maximum accepted here is 500).
SLIPPAGE_BPS=100
# Maximum gas * maxFeePerGas per approval/swap transaction, in wei (0.001 ETH).
MAX_GAS_COST_WEI=1000000000000000
