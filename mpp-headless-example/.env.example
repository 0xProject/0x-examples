# Base URL for MPP payments. Scripts append the price or quote route and query.
AGENTPAY_URL=https://agent.api.0x.org/v1/mpp-tempo-testnet
# Dedicated Tempo testnet wallet. Never commit its key.
PRIVATE_KEY=
# Payment chain: 42431 (Tempo Moderato testnet) or 4217 (Tempo mainnet).
CHAIN_ID=42431
# Testnet pathUSD. For mainnet, use USDC.e:
# 0x20C000000000000000000000b9537d11c60E8b50
PAYMENT_TOKEN=0x20c0000000000000000000000000000000000000
PAY_TO=0xb15a55e85FdF5edc41B6c1eaf7813e2c6e6def59
# Six-decimal token base units: 10000 = 0.01 tokens per payment (excludes gas).
MAX_PAYMENT_AMOUNT=10000
# Optional: defaults to the payment chain's public RPC.
RPC_URL=
# Swap parameters are independent of the payment network.
SWAP_CHAIN_ID=8453
SELL_TOKEN=0x833589fcd6edb6e08f4c7c32d4f71b54bda02913
BUY_TOKEN=0x4200000000000000000000000000000000000006
SELL_AMOUNT=1000000
# Quote taker; defaults to the payment account's address if omitted.
TAKER=
